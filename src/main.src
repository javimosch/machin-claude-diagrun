// diagrun: agent-first diagnostic of local Claude Code token usage.

func version() (v) { v = "0.4.2" }

// die prints the typed error (cli-output-spec §3). Only external failures
// (100-109) are worth retrying; the tool itself never retries.
func die(code, kind, message, suggestions) {
    again := "false"
    if code >= 100 && code <= 109 { again = "true" }
    eprintln("{\"ok\":false,\"error\":{\"code\":" + str(code) + ",\"type\":" + json(kind) + ",\"message\":" + json(message) + ",\"recoverable\":" + again + ",\"suggestions\":" + j_strings(suggestions) + "}}")
    exit(code)
}

func usage(message) { die(80, "invalid_argument", message, []string{"diagrun help-json"}) }

func bad_value(message, fix) { die(85, "invalid_value", message, []string{fix}) }

type Opts struct { cmd string  days int  root string  out string  owner string  artifact string  examples bool  publish bool  private bool  human bool  json_flag bool }

func parse_args(a) (o) {
    o = Opts{cmd: "", days: 7, root: env("HOME") + "/.claude/projects", out: "", owner: "", artifact: "diagrun", examples: false, publish: false, private: false, human: false, json_flag: false}
    i := 1
    for i < len(a) {
        x := a[i]
        if x == "--examples" { o.examples = true }
        else if x == "--publish" { o.publish = true }
        else if x == "--private" { o.private = true }
        else if x == "--human" { o.human = true }
        else if x == "--json" { o.json_flag = true }
        // nothing ever prompts: accepted so callers can pass them safely
        else if x == "--yes" || x == "-y" || x == "--no-interactive" { }
        else if x == "--help" || x == "--help-json" || x == "-h" { o.cmd = "help-json" }
        else if x == "--days" || x == "--root" || x == "--out" || x == "--owner" || x == "--artifact" {
            if i + 1 >= len(a) { usage(x + " needs a value") }
            v := a[i + 1]
            if x == "--days" { o.days = int_of(v) }
            if x == "--root" { o.root = v }
            if x == "--out" { o.out = v }
            if x == "--owner" { o.owner = v }
            if x == "--artifact" { o.artifact = v }
            i = i + 1
        }
        else if o.cmd == "" && !has_prefix(x, "-") { o.cmd = x }
        else { usage("unknown argument: " + x) }
        i = i + 1
    }
    if o.human && o.cmd != "guide" { usage("--human only applies to guide") }
    if o.human && o.json_flag { usage("--human and --json exclude each other") }
}

func int_of(v) (n) {
    if !regex_match(v, "^[0-9]{1,4}$") { bad_value("--days takes a positive integer", "diagrun scan --days 7") }
    n = parse_int(v)
    if n < 1 { bad_value("--days takes a positive integer", "diagrun scan --days 7") }
}

// check_publish runs before any scan, so a refused publish costs nothing and
// leaks nothing.
func check_publish(o) {
    if o.cmd != "report" { usage("--publish only applies to report") }
    // the strict pattern also keeps these values inert in the shell command
    if !regex_match(o.owner, "^[A-Za-z0-9][A-Za-z0-9._-]*$") { bad_value("--publish needs --owner (letters, digits, . _ -)", "diagrun report --publish --owner NAME") }
    if !regex_match(o.artifact, "^[A-Za-z0-9][A-Za-z0-9._-]*$") { bad_value("bad --artifact (letters, digits, . _ -)", "diagrun report --publish --owner NAME --artifact diagrun") }
    if o.examples && !o.private { die(85, "unsafe_publish", "--examples would publish prompts and commands: add --private", []string{"HART_READ_KEY=... diagrun report --examples --publish --owner NAME --private", "drop --examples"}) }
    if o.private && env("HART_READ_KEY") == "" { bad_value("--private needs HART_READ_KEY in the environment", "set HART_READ_KEY, or drop --private") }
}

func shell_quote(v) (q) { q = "'" + replace(v, "'", "'\\''") + "'" }

type Published struct { ok bool  url string  version int }

func publish(o, file) (url) {
    base := env("HART_URL")
    if base == "" { base = "https://hart.intrane.fr" }
    vis := "unlisted"
    if o.private { vis = "private" }
    // hart reads HART_READ_KEY from the environment, keeping it off the argv
    cmd := "HART_URL=" + shell_quote(base) + " hart publish " + shell_quote(file) + " --owner " + o.owner + " --artifact " + o.artifact + " --visibility " + vis
    code, out, errout := exec(cmd)
    res := Published{}
    if code == 0 { res = parse(trim(out), Published{}) }
    if res.url == "" { die(105, "publish_failed", trim(out + " " + errout), []string{"check that hart is installed and HART_URL is reachable: hart help", "rerun the same command"}) }
    url = res.url
}

type Written struct { ok bool  file string  url string  usd float  prompts int }

func main() {
    o := parse_args(args())
    if o.cmd == "guide" {
        if o.human { print(guide_human()) } else { println(guide_json()) }
        return
    }
    if o.cmd == "help-json" || o.cmd == "help" || o.cmd == "" {
        println(help_json())
        return
    }
    if o.cmd == "version" {
        if o.json_flag { println("{\"ok\":true,\"version\":" + json(version()) + "}") } else { println(version()) }
        return
    }
    if o.cmd != "scan" && o.cmd != "report" { usage("unknown command: " + o.cmd) }
    if o.publish { check_publish(o) }
    if !is_dir(o.root) { die(92, "no_data", "no transcript directory: " + o.root, []string{"diagrun scan --root DIR"}) }

    rep := analyze(load_all(o.root, o.days), o.days, version(), o.examples)
    if rep.totals.messages == 0 { die(92, "no_data", "no priced Claude messages in the last " + str(o.days) + " days", []string{"diagrun scan --days 30"}) }

    if o.cmd == "scan" {
        println(json(rep))
        return
    }
    out := o.out
    if out == "" {
        dir := env("HOME") + "/.diagrun"
        mkdir(dir)
        out = dir + "/report.html"
    }
    // the report can hold prompts: create it owner-only before writing
    system("umask 077 && : > " + shell_quote(out))
    if write_file(out, render_html(rep)) < 0 { die(92, "write_failed", "cannot write " + out, []string{"diagrun report --out FILE in a writable directory"}) }
    url := ""
    if o.publish { url = publish(o, out) }
    println(json(Written{ok: true, file: out, url: url, usd: rep.totals.usd, prompts: rep.totals.turns}))
}
